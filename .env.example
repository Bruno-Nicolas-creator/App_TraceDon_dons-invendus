# Base PostgreSQL (ex: Neon, Supabase, Vercel Postgres, ou serveur perso).
# DATABASE_URL : connexion "pooled" utilisée par l'application au runtime.
# DIRECT_URL   : connexion directe (sans pooler) utilisée par Prisma Migrate.
# Chez Neon les deux valeurs sont fournies séparément sur le dashboard du projet.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# --- DocuSign (signature électronique qualifiée) ---
# Voir le guide de configuration fourni pour obtenir ces valeurs (compte
# développeur DocuSign gratuit sur https://developers.docusign.com).
# Tant que ces variables sont absentes, les boutons de signature restent
# désactivés dans l'application (aucun crash).
DOCUSIGN_INTEGRATION_KEY=""
DOCUSIGN_USER_ID=""
DOCUSIGN_ACCOUNT_ID=""
# Clé privée RSA (PEM) générée pour la clé d'intégration DocuSign.
# Coller la clé sur une seule ligne avec des \n littéraux, par ex. :
# "-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"
DOCUSIGN_PRIVATE_KEY=""
# Environnement sandbox par défaut (ne pas changer avant la mise en production) :
DOCUSIGN_AUTH_SERVER="account-d.docusign.com"
DOCUSIGN_BASE_PATH="https://demo.docusign.net/restapi"

# --- Google Maps (distances réelles + carte interactive) ---
# Voir le guide de configuration fourni. Compte Google Cloud avec facturation
# activée nécessaire (crédit gratuit mensuel), APIs à activer : Geocoding API,
# Distance Matrix API, Maps JavaScript API.
# Tant que ces variables sont absentes, l'app affiche la carte/distance de secours
# (visuel statique) sans planter.
#
# Clé SERVEUR (Geocoding + Distance Matrix) : ne jamais l'exposer au navigateur,
# restreindre dans la console Google Cloud à ces deux APIs uniquement.
GOOGLE_MAPS_API_KEY=""
# Clé NAVIGATEUR (Maps JavaScript API) : sera visible côté client, restreindre
# dans la console Google Cloud par référent HTTP (ex: http://localhost:3000/*
# et le domaine de production).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
