# Base PostgreSQL (ex: Neon, Supabase, Vercel Postgres, ou serveur perso).
# DATABASE_URL : connexion "pooled" utilisée par l'application au runtime.
# DIRECT_URL   : connexion directe (sans pooler) utilisée par Prisma Migrate.
# Chez Neon les deux valeurs sont fournies séparément sur le dashboard du projet.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# --- DocuSign (signature électronique qualifiée) ---
# Voir le guide de configuration fourni pour obtenir ces valeurs (compte
# développeur DocuSign gratuit sur https://developers.docusign.com).
# Tant que ces variables sont absentes, les boutons de signature restent
# désactivés dans l'application (aucun crash).
DOCUSIGN_INTEGRATION_KEY=""
DOCUSIGN_USER_ID=""
DOCUSIGN_ACCOUNT_ID=""
# Clé privée RSA (PEM) générée pour la clé d'intégration DocuSign.
# Coller la clé sur une seule ligne avec des \n littéraux, par ex. :
# "-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"
DOCUSIGN_PRIVATE_KEY=""
# Environnement sandbox par défaut (ne pas changer avant la mise en production) :
DOCUSIGN_AUTH_SERVER="account-d.docusign.com"
DOCUSIGN_BASE_PATH="https://demo.docusign.net/restapi"

# --- Google Maps (distances réelles + carte interactive) ---
# Voir le guide de configuration fourni. Compte Google Cloud avec facturation
# activée nécessaire (crédit gratuit mensuel), APIs à activer : Geocoding API,
# Distance Matrix API, Maps JavaScript API.
# Tant que ces variables sont absentes, l'app affiche la carte/distance de secours
# (visuel statique) sans planter.
#
# Clé SERVEUR (Geocoding + Distance Matrix) : ne jamais l'exposer au navigateur,
# restreindre dans la console Google Cloud à ces deux APIs uniquement.
GOOGLE_MAPS_API_KEY=""
# Clé NAVIGATEUR (Maps JavaScript API) : sera visible côté client, restreindre
# dans la console Google Cloud par référent HTTP (ex: http://localhost:3000/*
# et le domaine de production).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Impact CO2 (ADEME) ---
# Clé gratuite obtenue auprès de l'équipe impactco2.fr (impactco2@ademe.fr).
# Tant que cette variable est absente, l'impact carbone n'est simplement pas
# affiché (aucun crash).
IMPACT_CO2_API_KEY=""

# --- Extraction automatique des articles (Gemini) ---
# Clé API Google AI Studio, gratuite dans les limites d'usage courantes :
# https://aistudio.google.com/apikey (compte Google, pas de carte bancaire requise
# pour rester dans le palier gratuit).
# Tant que cette variable est absente, le bouton "Extraire les articles" reste
# caché dans l'application (aucun crash).
GEMINI_API_KEY=""

# --- Notifications par email (Resend) ---
# Compte gratuit sur https://resend.com (jusqu'à 3000 emails/mois).
# Sans nom de domaine à soi vérifié chez Resend, seule l'adresse email du compte
# Resend peut recevoir de vrais emails (limite du prestataire, pas de l'appli) :
# https://resend.com/docs/dashboard/domains/introduction
# Tant que RESEND_API_KEY est absente, les notifications sont simplement ignorées
# (aucun crash) : positionnement, acceptation/refus, signature, nouveau message.
RESEND_API_KEY=""
# Adresse d'expédition. Par défaut "onboarding@resend.dev" (domaine de test Resend,
# qui ne peut écrire qu'à l'adresse du compte Resend). À remplacer par une adresse
# sur un domaine vérifié une fois disponible (ex. "dons@dons-invendus.fr").
RESEND_FROM_EMAIL=""

# --- Notifications push navigateur (Web Push) ---
# Gratuit et sans compte externe : générer une seule fois avec
# `npx web-push generate-vapid-keys`, puis coller les deux valeurs ci-dessous
# (VAPID_PUBLIC_KEY doit être identique à NEXT_PUBLIC_VAPID_PUBLIC_KEY).
# Tant que ces variables sont absentes, le bouton "Activer les notifications"
# reste caché dans l'application (aucun crash).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
