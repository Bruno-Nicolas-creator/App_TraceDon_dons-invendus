generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ENTREPRISE
  ASSOCIATION
  COORDINATEUR
}

enum StatutDon {
  BROUILLON
  PUBLIE
  PRIS_EN_CHARGE
  CLOTURE
  ANNULE
}

enum TypeDon {
  ALIMENTAIRE
  MATERIEL
}

// Nature déclarée à l'inscription : détermine quel(s) type(s) de don l'entreprise peut créer
// (loi AGEC art. 35 / L541-15-8 : obligation de réemploi/don distincte de celle de l'alimentaire,
// sans exigence de traçabilité DLC — le bon de remise et sa signature restent inchangés).
enum NatureActiviteEntreprise {
  ALIMENTAIRE
  ALIMENTAIRE_ET_NON_ALIMENTAIRE
  NON_ALIMENTAIRE
}

enum StatutArticle {
  EN_ATTENTE
  VALIDE
  REFUSE
}

// Distingue, dans la liste des bénévoles d'une association, qui est habilité à interagir avec
// le donateur (référent) de qui vient simplement collecter sur le terrain (collecteur).
enum RoleBenevole {
  REFERENT
  COLLECTEUR
}

enum StatutRescrit {
  NON_DEPOSE
  EN_ATTENTE
  ACCORD_TACITE
  REPONSE_RECUE
}

enum RoleSignataire {
  DONATEUR
  ASSOCIATION
}

enum StatutConvention {
  BROUILLON
  ENVOYEE
  SIGNEE
}

enum StatutHabilitation {
  NON_HABILITEE
  REGIONALE
  NATIONALE
}

enum PreferenceAlerte {
  EMAIL
  SMS
  SMS_EMAIL
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  nom           String
  role          Role
  entrepriseId  String?
  entreprise    Entreprise? @relation(fields: [entrepriseId], references: [id])
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id])
  messages      Message[]
  createdAt     DateTime @default(now())
}

model Enseigne {
  id             String       @id @default(cuid())
  denomination   String
  siretSiege     String
  nombreSieges   Int          @default(1)
  entreprises    Entreprise[]
  abonnement     Abonnement?
  createdAt      DateTime     @default(now())
}

model Abonnement {
  id           String   @id @default(cuid())
  enseigneId   String   @unique
  enseigne     Enseigne @relation(fields: [enseigneId], references: [id])
  formule      String
  montant      Float
  periodicite  String
  dateDebut    DateTime @default(now())
  statut       String   @default("actif")
}

model Entreprise {
  id                    String   @id @default(cuid())
  raisonSociale         String
  formeJuridique        String?
  siret                 String
  adresse               String
  secteurActivite       String?
  coutRevientKg         Float    @default(0)
  surfaceVenteM2        Float?
  referentDonNom        String?
  referentDonTelephone  String?
  natureActivite        NatureActiviteEntreprise @default(ALIMENTAIRE)
  latitude              Float?
  longitude             Float?
  enseigneId            String?
  enseigne         Enseigne? @relation(fields: [enseigneId], references: [id])
  users            User[]
  dons             Don[]
  bonsEnlevement   BonEnlevement[]
  attestations     AttestationFiscale[]
  attestationsInteretGeneral AttestationInteretGeneral[]
  conventions      Convention[]
  assignationsRecurrentes AssignationRecurrente[]
  documents        Document[]
  periodesConges   PeriodeConges[]
  conversations    Conversation[]
  createdAt        DateTime @default(now())
}

model Reseau {
  id            String        @id @default(cuid())
  denomination  String
  perimetre     String?
  associations  Association[]
}

model Association {
  id                        String        @id @default(cuid())
  denomination              String
  rna                       String
  adresse                   String
  categorieEligibilite      String?
  categoriesDon             String[]      @default([])
  disponibilitesRetrait     String[]      @default([])
  typesActivite             String[]      @default([])
  notreAction               String?
  preferenceAlerte          PreferenceAlerte @default(EMAIL)
  telephoneAlerteSms        String?
  declarationInteretGeneral Boolean       @default(false)
  rescritStatut             StatutRescrit @default(NON_DEPOSE)
  rescritDateDepot          DateTime?
  verifiee                  Boolean       @default(false)
  verifieeLe                DateTime?
  verifieePar               String?
  habilitationStatut        StatutHabilitation @default(NON_HABILITEE)
  habilitationDateFin       DateTime?
  declarationDdpp           Boolean       @default(false)
  declarationDdppDate       DateTime?
  referentDonNom            String?
  referentDonTelephone      String?
  // Personne à prévenir immédiatement en cas de rappel/retrait d'un produit déjà distribué —
  // distincte du référent don au quotidien.
  contactRappelNom          String?
  contactRappelTelephone    String?
  contactRappelEmail        String?
  latitude                  Float?
  longitude                 Float?
  reseauId                  String?
  reseau                    Reseau?       @relation(fields: [reseauId], references: [id])
  users                     User[]
  donsAssignes              Don[]
  bonsEnlevement            BonEnlevement[]
  attestations              AttestationFiscale[]
  attestationsInteretGeneral AttestationInteretGeneral[]
  conventions               Convention[]
  assignationsRecurrentes   AssignationRecurrente[]
  benevoles                 Benevole[]
  documents                 Document[]
  periodesConges            PeriodeConges[]
  conversations             Conversation[]
  createdAt                 DateTime      @default(now())
}

model Benevole {
  id                   String      @id @default(cuid())
  associationId        String
  association          Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  nom                  String
  telephone            String?
  role                 RoleBenevole @default(COLLECTEUR)
  assuranceRcAttestee  Boolean     @default(false)
  assuranceRcAttesteeLe DateTime?
  // Mandat de signature donné par le président de l'association à ce bénévole pour signer les
  // bordereaux de remise en son nom (cf. Mandat_Signature_Association_Benevole).
  mandatDonneLe        DateTime?
  bonsCollectes        BonEnlevement[]
  createdAt            DateTime    @default(now())
}

// Congés / fermeture déclarés par un commerçant ou une association : visibles par l'autre
// partie et bloquent les dons/validations pendant la période (cf. src/lib/conges.ts).
model PeriodeConges {
  id            String       @id @default(cuid())
  entrepriseId  String?
  entreprise    Entreprise?  @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)
  debut         DateTime
  fin           DateTime
  motif         String?
  createdAt     DateTime     @default(now())
}

enum PrioriteMessage {
  NORMALE
  IMPORTANTE
  URGENTE
}

// Messagerie interne organisée par fils de discussion : soit entre une entreprise et une
// association (partenaires ayant signé une convention), soit entre l'une des deux et le
// coordinateur de la plateforme (canal support). `avecCoordinateur` distingue les deux cas
// puisque `entrepriseId`/`associationId` peuvent chacun être seuls renseignés dans les deux.
model Conversation {
  id                  String        @id @default(cuid())
  entrepriseId        String?
  entreprise          Entreprise?   @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  associationId       String?
  association         Association?  @relation(fields: [associationId], references: [id], onDelete: Cascade)
  avecCoordinateur    Boolean       @default(false)
  luParEntrepriseLe   DateTime?
  luParAssociationLe  DateTime?
  luParCoordinateurLe DateTime?
  messages            Message[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Message {
  id                      String          @id @default(cuid())
  conversationId          String
  conversation            Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expediteurId            String
  expediteur              User            @relation(fields: [expediteurId], references: [id])
  contenu                 String?
  priorite                PrioriteMessage @default(NORMALE)
  pieceJointeNomFichier   String?
  pieceJointeContentType  String?
  pieceJointeContenu      Bytes?
  pieceJointeTailleOctets Int?
  createdAt               DateTime        @default(now())
}

enum TypeDocument {
  KBIS
  RECEPISSE_RNA
  ATTESTATION_ASSURANCE
  STATUTS_SIGNES
  PREUVE_RESCRIT_FISCAL
  HABILITATION_AIDE_ALIMENTAIRE
  DECLARATION_DDPP
  PV_ASSEMBLEE_GENERALE
  ASSURANCE_TRANSPORT_STOCKAGE
  ATTESTATION_CHAINE_FROID
  MANDAT_SIGNATURE_BENEVOLE
}

model Document {
  id            String        @id @default(cuid())
  type          TypeDocument
  nomFichier    String
  contentType   String
  contenu       Bytes
  tailleOctets  Int
  entrepriseId  String?
  entreprise    Entreprise?   @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  associationId String?
  association   Association?  @relation(fields: [associationId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@unique([entrepriseId, type])
  @@unique([associationId, type])
}

// Planning hebdomadaire : association(s) attendue(s) chaque jour de la semaine
// pour un enlèvement récurrent.
model AssignationRecurrente {
  id            String      @id @default(cuid())
  entrepriseId  String
  entreprise    Entreprise  @relation(fields: [entrepriseId], references: [id])
  jourSemaine   Int // 0 = lundi ... 6 = dimanche
  associationId String
  association   Association @relation(fields: [associationId], references: [id])
  actif         Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@unique([entrepriseId, jourSemaine, associationId])
}

model Convention {
  id                     String           @id @default(cuid())
  entrepriseId           String
  entreprise             Entreprise       @relation(fields: [entrepriseId], references: [id])
  associationId          String
  association            Association      @relation(fields: [associationId], references: [id])
  statut                 StatutConvention @default(BROUILLON)
  dureeAns               Int              @default(1)
  docusignEnvelopeId     String?
  signatureEntrepriseLe  DateTime?
  signatureAssociationLe DateTime?
  createdAt              DateTime         @default(now())

  @@unique([entrepriseId, associationId])
}

model Don {
  id                  String       @id @default(cuid())
  entrepriseId        String
  entreprise          Entreprise   @relation(fields: [entrepriseId], references: [id])
  statut              StatutDon    @default(BROUILLON)
  type                TypeDon      @default(ALIMENTAIRE)
  categorie           String       @default("Alimentaire")
  divisible           Boolean      @default(false)
  instructionsAcces   String?
  titre               String?
  description         String?
  adresseRecuperation String?
  pieceJointeNomFichier   String?
  pieceJointeContentType  String?
  pieceJointeContenu      Bytes?
  distanceLabel       String?
  associationAssigneeId String?
  associationAssignee Association? @relation(fields: [associationAssigneeId], references: [id])
  articles            Article[]
  bonEnlevement       BonEnlevement?
  createdAt           DateTime     @default(now())
  publieLe            DateTime?
}

model Article {
  id                 String        @id @default(cuid())
  donId              String
  don                Don           @relation(fields: [donId], references: [id], onDelete: Cascade)
  codeBarres         String?
  designation        String
  // Catégorie choisie parmi src/lib/categoriesDon.ts, uniquement pour les articles ajoutés à la
  // main (cf. AjouterArticleForm) — pas pour ceux scannés ou extraits automatiquement.
  categorie          String?
  quantiteDeclaree   String
  quantiteConstatee  String?
  poidsKg            Float
  dlcOuEtat          String?
  temperature        String?
  dlcDepassee        Boolean       @default(false)
  statut             StatutArticle @default(EN_ATTENTE)
  motifRefus         String?
  photoNomFichier    String?
  photoContentType   String?
  photoContenu       Bytes?
  createdAt          DateTime      @default(now())
}

model BonEnlevement {
  id                       String      @id @default(cuid())
  numero                   String      @unique
  donId                    String      @unique
  don                      Don         @relation(fields: [donId], references: [id])
  entrepriseId             String
  entreprise               Entreprise  @relation(fields: [entrepriseId], references: [id])
  associationId            String
  association              Association @relation(fields: [associationId], references: [id])
  dateHeureEnlevement      DateTime?
  poidsTotalRetenu         Float?
  signatureDonateurLe      DateTime?
  signatureAssociationLe   DateTime?
  // Bénévole mandaté qui signe effectivement ce bon au nom de l'association (cf. Mandat de
  // signature) : sert de nom de signataire pour DocuSign, à défaut la dénomination de
  // l'association est utilisée. SetNull si le bénévole est retiré : n'invalide pas le bon.
  benevoleCollecteurId     String?
  benevoleCollecteur       Benevole?   @relation(fields: [benevoleCollecteurId], references: [id], onDelete: SetNull)
  confirme                 Boolean     @default(false)
  docusignEnvelopeId       String?
  signatures               Signature[]
  attestationId            String?
  attestation              AttestationFiscale? @relation(fields: [attestationId], references: [id])
  createdAt                DateTime    @default(now())
}

model Signature {
  id              String         @id @default(cuid())
  bonEnlevementId String
  bonEnlevement   BonEnlevement  @relation(fields: [bonEnlevementId], references: [id], onDelete: Cascade)
  role            RoleSignataire
  signataireNom   String?
  horodatage      DateTime       @default(now())
  referenceDocuSign String?
}

enum StatutAttestation {
  BROUILLON
  ENVOYEE
  SIGNEE
}

model AttestationFiscale {
  id                     String            @id @default(cuid())
  numeroOrdre            String            @unique
  entrepriseId           String
  entreprise             Entreprise        @relation(fields: [entrepriseId], references: [id])
  associationId          String
  association            Association       @relation(fields: [associationId], references: [id])
  periodeDebut           DateTime
  periodeFin             DateTime
  montantCalcule         Float
  statut                 StatutAttestation @default(BROUILLON)
  docusignEnvelopeId     String?
  signatureAssociationLe DateTime?
  bonsEnlevement         BonEnlevement[]
  createdAt              DateTime          @default(now())
}

enum StatutAttestationInteretGeneral {
  BROUILLON
  ENVOYEE
  SIGNEE
}

// Attestation sur l'honneur du statut d'intérêt général (art. 238 bis du CGI), signée par
// l'association et adressée à une entreprise donatrice nommée (contrairement à AttestationFiscale,
// non rattachée à une période ou des bons précis : une seule par couple entreprise/association).
model AttestationInteretGeneral {
  id                     String                           @id @default(cuid())
  entrepriseId           String
  entreprise             Entreprise                       @relation(fields: [entrepriseId], references: [id])
  associationId          String
  association            Association                      @relation(fields: [associationId], references: [id])
  statut                 StatutAttestationInteretGeneral @default(BROUILLON)
  docusignEnvelopeId     String?
  signatureAssociationLe DateTime?
  createdAt              DateTime                         @default(now())

  @@unique([entrepriseId, associationId])
}
